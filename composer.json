{
  "name": "alvarorosado/test-kafka-transport",
  "description": "A Symfony bundle for integrating Kafka with Messenger",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Alvaro Rosado",
      "email": "alvaro.rosado@exoticca.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "symfony/messenger": "^6.0 || ^7.0",
    "symfony/dependency-injection": "^6.0 || ^7.0",
    "symfony/http-kernel": "^6.0 || ^7.0",
    "symfony/config": "^6.0 || ^7.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/contracts": "^2.5 || ^3.0",
    "symfony/http-client": "^6.0 || ^7.0",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Exoticca\\KafkaMessenger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Exoticca\\KafkaMessenger\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "symfony/phpunit-bridge": "^6.0"
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  }
}
